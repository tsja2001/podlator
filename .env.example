# === Podlator 配置 ===
# 复制本文件为 .env，填入你的 API Key

# ── API Keys ──
DEEPGRAM_API_KEY=
DEEPSEEK_API_KEY=
CLAUDE_API_KEY=

# ── Provider 选择 ──
# STT_PROVIDER=deepgram            # deepgram | tencent_cloud | mlx_whisper
# LLM_PROVIDER_SUMMARIZE=deepseek
# LLM_PROVIDER_POLISH=claude

# ── 日志 ──
# LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR
# LOG_JSON_ENABLED=true

# ── DeepSeek（OpenAI 兼容 API）──
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-v4-flash
# DEEPSEEK_MAX_TOKENS=8192

# ── Claude（第三方平台，OpenAI 兼容 API）──
# CLAUDE_BASE_URL=https://api.b.ai/v1
# CLAUDE_MODEL=claude-opus-4.7
# CLAUDE_MAX_TOKENS=4096

# ── Tencent ASR（录音文件识别）──
# TENCENT_APP_ID=
# TENCENT_SECRET_ID=
# TENCENT_SECRET_KEY=
# TENCENT_ASR_REGION=ap-shanghai
# TENCENT_ASR_ENGINE_MODEL_TYPE=16k_zh_large
# TENCENT_ASR_RES_TEXT_FORMAT=2
# TENCENT_ASR_SPEAKER_DIARIZATION=0
# TENCENT_ASR_POLL_INTERVAL_SECONDS=3.0
# TENCENT_ASR_TIMEOUT_SECONDS=10800.0

# ── Tencent COS（ASR 临时音频）──
# TENCENT_COS_BUCKET=podlator-audio-1234567890
# TENCENT_COS_REGION=ap-shanghai
# TENCENT_COS_SECRET_ID=
# TENCENT_COS_SECRET_KEY=
# TENCENT_COS_TOKEN=
# TENCENT_COS_PREFIX=podlator/asr-audio
# TENCENT_COS_SCHEME=https
# TENCENT_COS_PRESIGNED_EXPIRES_SECONDS=21600
# TENCENT_COS_DELETE_AFTER_TRANSCRIBE=true
