# === Podlator 配置 ===
# 复制本文件为 .env

# ── 必填：LLM API Key ──
# 当前所有 LLM 调用都走 DeepSeek（便宜模型出蓝图 + V4-Pro 定稿）
DEEPSEEK_API_KEY=sk-c7c75d680101441383b874eeeb2be3f3

# ── LLM Provider 选择 ──
# 两个阶段可以分别选不同 provider：
#   Stage1 蓝图 / assign-speakers 用下面这个（便宜快模型）
LLM_PROVIDER_SUMMARIZE=deepseek
#   Stage2 定稿 用下面这个。可选：deepseek（当前）/ claude_cli / codex_cli
# LLM_PROVIDER_POLISH=deepseek

# ── 如果 Stage2 用本机 CLI 强模型（claude -p），取消下面注释 ──
LLM_PROVIDER_POLISH=claude_cli
CLI_TOOL_CLAUDE_MODEL=claude-sonnet-4-6
CLI_TOOL_TIMEOUT_S=600

# ── 外部 TTS 工具（语音合成由 speech-transcriber 项目负责）──
SPEECH_TRANSCRIBER_PROJECT_DIR=/Users/mac/Project_Personal/speech-transcriber
SPEECH_TRANSCRIBER_PROVIDER=tencent_cloud
