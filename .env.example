# ======================================================================
# Podlator 配置
# ======================================================================
# 复制本文件为 .env，填入你的配置。
#
# LLM Provider 速查（决定「用什么模型、怎么计费」）：
#
#   Provider 值          | 实际调用方式         | 决定模型的配置项        | 计费方式
#   ---------------------|----------------------|-------------------------|------------------
#   deepseek             | DeepSeek API         | DEEPSEEK_MODEL          | API 按 token
#   claude               | 第三方 OpenAI 兼容   | CLAUDE_MODEL            | 第三方 API 按 token
#   claude_cli           | 本机 claude -p       | CLI_TOOL_CLAUDE_MODEL   | Claude 订阅额度
#   codex_cli            | 本机 codex exec      | CLI_TOOL_CODEX_MODEL    | ChatGPT 订阅额度
#
#   claude_cli / codex_cli 是「CLI 强模型」：通过本机已登录的会员态调用，
#   不走第三方 API，成本更低。自动在临时空目录运行，隔离项目上下文。
#   Stage2 定稿失败时会自动降级到 deepseek API。
#
# 典型配置示例：
#
#   # 方案 A：两段式默认 — DeepSeek 出蓝图 + Claude CLI 定稿
#   LLM_PROVIDER_SUMMARIZE=deepseek
#   LLM_PROVIDER_POLISH=claude_cli
#   CLI_TOOL_CLAUDE_MODEL=claude-sonnet-4-6
#
#   # 方案 B：两段式 — DeepSeek 出蓝图 + Codex CLI 定稿
#   LLM_PROVIDER_SUMMARIZE=deepseek
#   LLM_PROVIDER_POLISH=codex_cli
#   CLI_TOOL_CODEX_MODEL=gpt-5.5
#
#   # 方案 C：省钱 — 全部 DeepSeek API
#   LLM_PROVIDER_SUMMARIZE=deepseek
#   LLM_PROVIDER_POLISH=deepseek
#
# ======================================================================

# ── API Keys（仅 deepseek / claude provider 需要）──
DEEPGRAM_API_KEY=
DEEPSEEK_API_KEY=
CLAUDE_API_KEY=

# ── Provider 选择 ──
# LLM_PROVIDER_SUMMARIZE=deepseek   # Stage1：章节摘要 / 解说蓝图
# LLM_PROVIDER_POLISH=claude_cli    # Stage2：最终润色 / 口播定稿
# LLM_PROVIDER_JUDGE=deepseek       # 评估/审稿用 judge 模型，便宜优先
# STT_PROVIDER=deepgram             # deepgram | tencent_cloud | mlx_whisper

# ── 日志 ──
# LOG_LEVEL=INFO                    # DEBUG | INFO | WARNING | ERROR
# LOG_JSON_ENABLED=true

# ── DeepSeek（OpenAI 兼容 API）──
# DeepSeek V4-Flash：上下文窗口 1,000,000（输入+输出总容量），单次最大生成 max_tokens 上限 384,000。
# 注意区分二者：上下文窗口是"桌子多大"，max_tokens 是"一次铺多大的纸"。
# 这里 32768 是中间值——足够 6000 字中文定稿(≈12K token)，又不至于在 prompt 出 bug 时狂输出浪费。
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-v4-flash
# DEEPSEEK_MAX_TOKENS=32768

# ── Claude（第三方平台，OpenAI 兼容 API，仅 provider=claude 时使用）──
# CLAUDE_BASE_URL=https://api.b.ai/v1
# CLAUDE_MODEL=claude-opus-4.7
# CLAUDE_MAX_TOKENS=8192

# ── CLI Tool Provider（仅 provider=claude_cli 或 codex_cli 时使用）──
# 通过本机已登录的 CLI（claude -p / codex exec）调用官方强模型。
# - claude_cli → 读取 CLI_TOOL_CLAUDE_MODEL，用量走 Claude 订阅的 Agent SDK 额度
# - codex_cli → 读取 CLI_TOOL_CODEX_MODEL，用量走 ChatGPT 订阅的 agentic 额度
# 两个 CLI 共享 CLI_TOOL_TIMEOUT_S 超时配置。
#
# CLI_TOOL_CLAUDE_MODEL=claude-sonnet-4-6   # claude_cli 使用的模型
# CLI_TOOL_CODEX_MODEL=                      # codex_cli 模型（留空用默认）
# CLI_TOOL_TIMEOUT_S=600                     # 子进程超时（秒）

# ── Tencent ASR（录音文件识别）──
# TENCENT_APP_ID=
# TENCENT_SECRET_ID=
# TENCENT_SECRET_KEY=
# TENCENT_ASR_REGION=ap-shanghai
# TENCENT_ASR_ENGINE_MODEL_TYPE=16k_zh_large
# TENCENT_ASR_RES_TEXT_FORMAT=2
# TENCENT_ASR_SPEAKER_DIARIZATION=0
# TENCENT_ASR_POLL_INTERVAL_SECONDS=3.0
# TENCENT_ASR_TIMEOUT_SECONDS=10800.0

# ── Tencent COS（ASR 临时音频）──
# TENCENT_COS_BUCKET=podlator-audio-1234567890
# TENCENT_COS_REGION=ap-shanghai
# TENCENT_COS_SECRET_ID=
# TENCENT_COS_SECRET_KEY=
# TENCENT_COS_TOKEN=
# TENCENT_COS_PREFIX=podlator/asr-audio
# TENCENT_COS_SCHEME=https
# TENCENT_COS_PRESIGNED_EXPIRES_SECONDS=21600
# TENCENT_COS_DELETE_AFTER_TRANSCRIBE=true

# ── Speech Transcriber（外部 CLI 转写工具）──
# SPEECH_TRANSCRIBER_PROJECT_DIR=/path/to/speech-transcriber
# SPEECH_TRANSCRIBER_PROVIDER=tencent_cloud
